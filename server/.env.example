# server/scripts/autoFetchImport.js が読み込む、予約サイト(よやクルPro)の
# ログイン情報。このファイルをコピーして server/.env を作成し、実際の値を
# 入力してください(server/.env は .gitignore 済みで、git にはコミットされません)。
#
#   cp server/.env.example server/.env

YOYAKUL_ID=
YOYAKUL_PASSWORD=

# ダッシュボード自体のログイン(server/src/auth.js)。SESSION_SECRETは
# ランダムな長い文字列にしてください(例: `openssl rand -hex 32` の出力)。
DASHBOARD_USER=
DASHBOARD_PASSWORD=
SESSION_SECRET=
