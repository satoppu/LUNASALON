# server/scripts/autoFetchImport.js が読み込む、予約サイト(よやクルPro)の
# ログイン情報。このファイルをコピーして server/.env を作成し、実際の値を
# 入力してください(server/.env は .gitignore 済みで、git にはコミットされません)。
#
#   cp server/.env.example server/.env

YOYAKUL_ID=
YOYAKUL_PASSWORD=

# ダッシュボード自体のログイン(server/src/auth.js)。SESSION_SECRETは
# ランダムな長い文字列にしてください(例: `openssl rand -hex 32` の出力)。
DASHBOARD_USER=
DASHBOARD_PASSWORD=
SESSION_SECRET=

# 自動取り込み(autoFetchImport.js)の実行結果をメールで通知する場合に設定。
# 3つとも設定されていない場合はメール通知をスキップし、自動取り込み自体は
# 通常通り実行されます。
# GMAIL_USER: 送信元のGmailアドレス
# GMAIL_APP_PASSWORD: Googleアカウントで2段階認証を有効にした上で発行する
#   「アプリパスワード」(通常のログインパスワードではない)。
#   https://myaccount.google.com/apppasswords から発行できます。
# NOTIFY_EMAIL_TO: 通知の送り先アドレス(送信元と同じでも可)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=
